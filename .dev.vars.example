# Copy this file to .dev.vars. Never commit real secrets.
TURSO_DATABASE_URL=turso://your-database.turso.io
TURSO_AUTH_TOKEN=
RESEND_API_KEY=
# Development only: Resend permits onboarding@resend.dev to send test mail to
# the email address associated with your Resend account.
EMAIL_FROM=CrashLens <onboarding@resend.dev>
APP_ORIGIN=http://localhost:3000
ADMIN_EMAILS=you@example.com

# Machine ingestion. Use a long random value and your workspace team id.
INGESTION_TOKEN=
INGESTION_TEAM_ID=

# Uptime runner and optional incident destinations.
MONITOR_CRON_TOKEN=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
OPENAI_API_KEY=
